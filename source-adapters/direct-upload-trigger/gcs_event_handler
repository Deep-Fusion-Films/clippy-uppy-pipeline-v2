import json
from typing import Dict, Any


# -----------------------------
# Helpers
# -----------------------------

def is_video_file(name: str) -> bool:
    """Return True if the object name ends with a supported video extension."""
    return name.lower().endswith((
        ".mp4", ".mov", ".mkv", ".avi", ".mxf"
    ))


def is_direct_upload(name: str) -> bool:
    """Return True if the object is inside the direct-upload/ folder."""
    return name.startswith("direct-upload/")


# -----------------------------
# Main handler
# -----------------------------

def handle_gcs_event(request) -> str:
    """
    Cloud Run entrypoint for GCS -> Eventarc events.
    Expects a CloudEvent-style JSON payload.
    """

    try:
        envelope = request.get_json()
    except Exception:
        print("ERROR: Request did not contain valid JSON")
        return "invalid-json", 400

    if not envelope:
        print("ERROR: Empty request payload")
        return "empty-payload", 400

    # Eventarc wraps the actual GCS event inside 'data'
    event_data: Dict[str, Any] = envelope.get("data", {})
    if not event_data:
        print("ERROR: No 'data' field in event")
        return "no-data", 400

    bucket = event_data.get("bucket")
    object_name = event_data.get("name")

    if not bucket or not object_name:
        print("ERROR: Missing bucket or object name in event")
        return "missing-fields", 400

    print(f"Received GCS event for object: {object_name} in bucket: {bucket}")

    # -----------------------------
    # Folder filtering
    # -----------------------------
    if not is_direct_upload(object_name):
        print(f"Ignoring object outside direct-upload/: {object_name}")
        return "ignored-non-direct-upload", 200

    # -----------------------------
    # File type filtering
    # -----------------------------
    if not is_video_file(object_name):
        print(f"Ignoring non-video file: {object_name}")
        return "ignored-non-video", 200

    # -----------------------------
    # Extract asset ID
    # -----------------------------
    filename = object_name.split("/")[-1]
    asset_id = filename.rsplit(".", 1)[0]

    print(f"Processing direct-upload video: {object_name}")
    print(f"Extracted asset_id: {asset_id}")

    # -----------------------------
    # TODO: Publish to Pub/Sub or call next service
    # -----------------------------
    # publish_to_pipeline(asset_id, bucket, object_name)

    return "processed", 200
